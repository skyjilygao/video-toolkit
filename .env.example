# Video Toolkit 环境变量配置
# 复制为 .env 并填入你的 API Key

# ===== AI 服务 =====
# fal.ai (FLUX图片 + Kling/Seedance/Hailuo视频)
FAL_KEY=

# OpenAI (DALL-E图片 + TTS)
OPENAI_API_KEY=

# ElevenLabs (高质量 TTS)
ELEVENLABS_API_KEY=

# ===== 测试路径 =====
# 测试视频目录
TEST_VIDEO_DIR=

# ===== FFmpeg 路径 (可选，自动检测) =====
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
